# Copy to .env and adjust. Placeholder values only - never commit real secrets.

APP_ENV=development
LOG_LEVEL=INFO
LOG_JSON=true

# SQLite for local dev; docker-compose overrides this with PostgreSQL + pgvector.
DATABASE_URL=sqlite+aiosqlite:///./resume_matching.db
DB_CREATE_ALL=true

# Auth (JWT_SECRET must be >= 32 chars; required in production)
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_MINUTES=60
BCRYPT_ROUNDS=12
# Optional: create an admin account on startup if it does not exist
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# AI providers: LLM_PROVIDER=offline|openai|anthropic, EMBEDDING_PROVIDER=hashing|openai
LLM_PROVIDER=offline
EMBEDDING_PROVIDER=hashing
EMBEDDING_DIM=512
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
LLM_TIMEOUT_SECONDS=30

# Uploads
MAX_UPLOAD_BYTES=2097152
MAX_PDF_PAGES=10

# Privacy / limits
REDACT_ANALYSIS_PAYLOADS=true
ANALYZE_RATE_LIMIT_PER_MINUTE=20
ANALYZE_RATE_LIMIT_BURST=10
RANKING_CANDIDATE_POOL=500

# Scoring weights (changing any SCORING_* value changes scoring_version)
SCORING_WEIGHT_REQUIRED_SKILLS=0.40
SCORING_WEIGHT_NICE_TO_HAVE=0.10
SCORING_WEIGHT_EXPERIENCE=0.20
SCORING_WEIGHT_ROLE=0.10
SCORING_WEIGHT_SEMANTIC=0.20
SCORING_RELATED_SKILL_CREDIT=0.5
SCORING_KNOCKOUT_MISSING_CRITICAL_CAP=40

# docker-compose PostgreSQL (local development only)
POSTGRES_USER=matching
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=resume_matching

# Optional: run the @pytest.mark.postgres integration tests
# TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/resume_matching_test
